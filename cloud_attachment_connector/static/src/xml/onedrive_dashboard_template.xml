<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="microsoft_onedrive_connector.OneDriveDashboard" owl="1">
        <div class="o_onedrive_dashboard">
            <div class="o_onedrive_dashboard_header">
                <h2>Microsoft OneDrive Dashboard</h2>
                <div class="o_onedrive_dashboard_actions" t-if="state.configured">
                    <button class="btn btn-primary" t-on-click="refreshFiles">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                    <button class="btn btn-secondary" t-on-click="upload"
                            t-att-disabled="state.uploading ? true : undefined">
                        <i class="fa fa-upload"/> Upload
                    </button>
                </div>
            </div>

            <div t-if="state.uploading" class="o_onedrive_upload_progress alert alert-info mt-3 mb-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong t-esc="state.uploadFileName"/>
                    <span class="badge text-bg-primary"><t t-esc="state.uploadProgress"/>%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         t-att-style="'width: ' + state.uploadProgress + '%;'"/>
                </div>
                <small class="text-muted d-block mt-1" t-esc="state.uploadStatus"/>
            </div>

            <input type="search"
                   class="o_onedrive_header_search_input"
                   placeholder="Search Files"
                   t-on-input="onSearchInput"/>

            <div class="o_onedrive_dashboard_content">
                <div t-if="state.loading" class="o_onedrive_loading">
                    <i class="fa fa-spinner fa-spin"/> Loading files from OneDrive...
                </div>

                <div t-if="state.error" class="o_onedrive_error alert alert-danger">
                    <i class="fa fa-exclamation-triangle"/>
                    <strong>Error:</strong> <t t-esc="state.error"/>
                </div>

                <div t-if="state.configured &amp;&amp; !state.loading &amp;&amp; !state.error" class="o_onedrive_files">
                    <div t-if="state.files.length === 0" class="o_onedrive_empty">
                        <i class="fa fa-cloud-upload fa-3x text-muted"/>
                        <h3>No files found in OneDrive</h3>
                        <p>Upload files with <strong>Upload</strong> or via chatter; ensure the connector is configured.</p>
                    </div>

                    <div t-if="state.files.length > 0" class="o_onedrive_files_list">
                        <table class="table table-hover o_onedrive_files_table">
                            <thead>
                                <tr>
                                    <th>File Name</th>
                                    <th>Type</th>
                                    <th>Related Record</th>
                                    <th>Size</th>
                                    <th>Modified</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="filteredFiles" t-as="file" t-key="file.unique_key">
                                    <td>
                                        <i t-att-class="'fa ' + getFileIcon(file)"/>
                                        <t t-esc="file.name"/>
                                    </td>
                                    <td>
                                        <span class="badge text-bg-secondary" t-esc="file.type"/>
                                    </td>
                                    <td>
                                        <t t-if="file.res_model and file.res_id">
                                            <button type="button"
                                                    class="btn btn-link p-0 text-muted align-baseline related_record_link"
                                                    t-on-click="() => openRelatedRecord(file)">
                                                <t t-esc="file.related_record"/>
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="file.related_record || 'Manual Upload'"/>
                                        </t>
                                    </td>
                                    <td t-esc="formatFileSize(file.size)"/>
                                    <td t-esc="formatDate(file.modified)"/>
                                    <td>
                                        <button class="btn btn-sm btn-primary"
                                                t-on-click="() => downloadFile(file)"
                                                t-if="file.id">
                                            <i class="fa fa-download"/> Download
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
