<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="cloud_attachment_connector.MicrosoftOnedriveAuthorize" owl="1">
        <div class="container py-4">
            <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow">
                        <div class="modal-header">
                            <h5 class="modal-title">Authorize with Microsoft</h5>
                        </div>
                        <div class="modal-body">
                            <div t-if="state.status === 'authorized'" class="alert alert-success mb-0">
                                <strong>Authorization successful!</strong>
                                <div t-esc="state.message"/>
                            </div>
                            <div t-elif="state.status === 'error'" class="alert alert-danger mb-0">
                                <strong>Error:</strong>
                                <div t-esc="state.error"/>
                            </div>
                            <div t-else="">
                                <p class="mb-2">
                                    Go to
                                    <a t-att-href="state.verificationUri" target="_blank" rel="noopener noreferrer">
                                        <t t-esc="state.verificationUri"/>
                                    </a>
                                    and enter code:
                                </p>
                                <div class="alert alert-primary text-center fw-bold fs-4 mb-3" t-esc="state.userCode"/>
                                <p class="text-muted mb-0" t-esc="state.message"/>
                                <p class="text-muted mt-2 mb-0">
                                    The page will keep checking Microsoft every 3 seconds.
                                </p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" t-on-click="cancel" t-if="state.status !== 'authorized'">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
