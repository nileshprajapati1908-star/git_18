<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Search view for S3 Attachments -->
    <record id="view_s3_attachment_search" model="ir.ui.view">
        <field name="name">ir.attachment.search.s3</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <search string="S3 Attachments">
                <filter string="Stored on S3" name="s3_attachments" domain="[('is_s3_attachment', '=', True)]"/>
                <filter string="Chatter Attachments" name="chatter_attachments" domain="[('is_s3_attachment', '=', True), ('res_model', '!=', False), ('res_id', '!=', 0)]"/>
            </search>
        </field>
    </record>

</odoo>
