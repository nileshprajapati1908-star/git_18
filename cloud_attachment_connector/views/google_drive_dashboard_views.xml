<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Menu Views for Google Drive connector -->
    <!-- 
        The Google Drive Dashboard menu visibility is controlled by the 'view_dashboard' 
        checkbox in the Connector Routing Rules. When view_dashboard is enabled for any 
        confirmed Google Drive rule, the dashboard menu becomes visible in the menu bar.
        
        To hide this dashboard:
        1. Go to Settings → Cloud Connectors → Connector Routing Rules
        2. Open the Google Drive rule
        3. Uncheck the "View Dashboard" option
        4. Click Confirm
    -->
    <record id="google_drive_dashboard_action" model="ir.actions.client">
        <field name="name">Google Drive Dashboard</field>
        <field name="tag">cloud_attachment_connector_google_drive_dashboard</field>
        <field name="target">current</field>
    </record>
    <menuitem id="google_drive_connector_menu_root"
              name="Google Drive"
              web_icon="cloud_attachment_connector,static/src/img/drive.png"
              action="google_drive_dashboard_action"
              active="False"/>
    <menuitem id="google_drive_connector_dashboard_menu"
              name="Google Drive Dashboard"
              parent="google_drive_connector_menu_root"
              action="google_drive_dashboard_action"
              sequence="1"
              active="False"/>
</odoo>
