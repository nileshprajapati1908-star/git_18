<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Menu Views for amazon s3 connector -->
    <!-- 
        The Amazon S3 Dashboard menu visibility is controlled by the 'view_dashboard' 
        checkbox in the Connector Routing Rules. When view_dashboard is enabled for any 
        confirmed Amazon S3 rule, the dashboard menu becomes visible in the menu bar.
        
        To hide this dashboard:
        1. Go to Settings → Cloud Connectors → Connector Routing Rules
        2. Open the Amazon S3 rule
        3. Uncheck the "View Dashboard" option
        4. Click Confirm
    -->
    <record id="amazon_dashboard_action" model="ir.actions.client">
        <field name="name">Amazon S3 Dashboard</field>
        <field name="tag">amazon_dashboard</field>
        <field name="target">current</field>
    </record>
    <menuitem id="amazon_s3_connector_menu_root"
              name="Amazon S3"
              web_icon="cloud_attachment_connector,static/description/amazon_icon.png"
              action="amazon_dashboard_action"
              active="False"/>
    <menuitem id="amazon_s3_connector_dashboard_menu"
              name="Amazon S3 Dashboard"
              parent="amazon_s3_connector_menu_root"
              action="amazon_dashboard_action"
              sequence="1"
              active="False"/>
</odoo>
