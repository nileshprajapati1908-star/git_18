<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree view for OneDrive Attachments -->
    <record id="view_onedrive_attachment_tree" model="ir.ui.view">
        <field name="name">ir.attachment.tree.onedrive</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="res_model" column_invisible="1"/>
                <field name="res_id" column_invisible="1"/>
                <field name="res_name" string="Related Record"/>
            </xpath>

            <xpath expr="//field[@name='file_size']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='res_name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='res_model']" position="replace"/>
            <xpath expr="//field[@name='res_id']" position="replace"/>
            <xpath expr="//field[@name='res_name']" position="after">
                <field name="onedrive_item_id" optional="hide"/>
                <field name="onedrive_url" string="OneDrive URL" widget="url" optional="show"/>
                <field name="is_onedrive_attachment" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Form view for OneDrive Attachments -->
    <record id="view_onedrive_attachment_form" model="ir.ui.view">
        <field name="name">ir.attachment.form.onedrive</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_refresh_onedrive_url" type="object" string="Refresh OneDrive URL" class="btn-primary" invisible="not is_onedrive_attachment"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='datas']" position="after">
                <group string="OneDrive Information" invisible="not is_onedrive_attachment">
                    <field name="is_onedrive_attachment" invisible="1"/>
                    <field name="onedrive_item_id" readonly="1"/>
                    <field name="onedrive_url" string="OneDrive URL" readonly="1" widget="url"/>
                    <button name="action_open_onedrive_object" type="object" string="Open Object URL" class="btn-link"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Search view for OneDrive Attachments -->
    <record id="view_onedrive_attachment_search" model="ir.ui.view">
        <field name="name">ir.attachment.search.onedrive</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <search string="OneDrive Attachments">
                <filter string="Stored on OneDrive" name="onedrive_attachments" domain="[('is_onedrive_attachment', '=', True)]"/>
                <filter string="Chatter Attachments" name="chatter_attachments" domain="[('is_onedrive_attachment', '=', True), ('res_model', '!=', False), ('res_id', '!=', 0)]"/>
            </search>
        </field>
    </record>

</odoo>
