<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree view for Google Drive Attachments -->
    <record id="view_drive_attachment_tree" model="ir.ui.view">
        <field name="name">ir.attachment.tree.drive</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="res_model" column_invisible="1"/>
                <field name="res_id" column_invisible="1"/>
                <field name="res_name" string="Related Record"/>
            </xpath>

            <xpath expr="//field[@name='file_size']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='res_name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='res_model']" position="replace"/>
            <xpath expr="//field[@name='res_id']" position="replace"/>
            <xpath expr="//field[@name='res_name']" position="after">
                <field name="drive_file_id" optional="hide"/>
                <field name="drive_url" string="Google Drive URL" widget="url" optional="show"/>
                <field name="is_drive_attachment" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Form view for Google Drive Attachments -->
    <record id="view_drive_attachment_form" model="ir.ui.view">
        <field name="name">ir.attachment.form.drive</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_refresh_drive_url" type="object" string="Refresh Drive URL" class="btn-primary" invisible="not is_drive_attachment"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='datas']" position="after">
                <group string="Google Drive Information" invisible="not is_drive_attachment">
                    <field name="is_drive_attachment" invisible="1"/>
                    <field name="drive_file_id" readonly="1"/>
                    <field name="drive_url" string="Google Drive URL" readonly="1" widget="url"/>
                    <button name="action_open_drive_object" type="object" string="Open Object URL" class="btn-link"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Search view for Google Drive Attachments -->
    <record id="view_drive_attachment_search" model="ir.ui.view">
        <field name="name">ir.attachment.search.drive</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <search string="Google Drive Attachments">
                <filter string="Stored on Google Drive" name="drive_attachments" domain="[('is_drive_attachment', '=', True)]"/>
                <filter string="Chatter Attachments" name="chatter_attachments" domain="[('is_drive_attachment', '=', True), ('res_model', '!=', False), ('res_id', '!=', 0)]"/>
            </search>
        </field>
    </record>

    <!-- Action for Google Drive Attachments -->
    <record id="action_drive_attachments" model="ir.actions.act_window">
        <field name="name">Google Drive Attachments</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drive_attachment_search"/>
        <field name="domain">[('is_drive_attachment', '=', True)]</field>
        <field name="context">{'default_is_drive_attachment': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Google Drive attachments found
            </p>
            <p>
                Attachments uploaded to Google Drive will appear here.
                Enable auto-upload in settings to automatically upload chatter attachments.
            </p>
        </field>
    </record>

    <record id="action_drive_attachments_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_drive_attachment_tree"/>
        <field name="act_window_id" ref="action_drive_attachments"/>
    </record>

    <record id="action_drive_attachments_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_drive_attachment_form"/>
        <field name="act_window_id" ref="action_drive_attachments"/>
    </record>

    <!-- Menu item for Google Drive Attachments -->
    <menuitem id="menu_drive_attachments"
              name="Google Drive Attachments"
              parent="google_drive_connector_menu_root"
              action="action_drive_attachments"
              sequence="10"/>
</odoo>
